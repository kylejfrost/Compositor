<plist version="1.0">
<dict>
    <!-- No App Sandbox: the app needs to open and save files anywhere the user can, including
         for AI agents driving it over MCP. Uses the hardened runtime only; the opt-in MCP
         server binds 127.0.0.1 (Compositor › Settings…, off by default). -->
</dict>
</plist>
